# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/support_desk?appName=Cluster0

# OpenAI API Key (not used — replaced by Cohere)
# OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Key (used for embeddings & chat completions — FREE tier)
COHERE_API_KEY=your_cohere_api_key_here

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=nextjs-docs
